<Page x:Class="bank.WDPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:bank"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WDPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Снятие наличных" FontSize="24" Margin="0,10" HorizontalAlignment="Center"/>
            <TextBlock Text="Введите сумму" FontSize="18" Margin="0,10" HorizontalAlignment="Center" />

            <TextBlock x:Name="AmountBox" Width="280" Height="50" FontSize="24" HorizontalAlignment="Center"  Margin="0,20" />

            <Button Content="Завершить" Width="280" Height="40" Margin="0,90,0,10" Click="ButEWD_Click"/>
            <Button Content="Отмена" Width="280" Height="40" Click="ButBWD_Click"/>
        </StackPanel>
    </Grid>
</Page>

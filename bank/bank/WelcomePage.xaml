<Page x:Class="bank.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:bank"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WelcomePage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
            <TextBlock Text="Банкомат" FontSize="36" FontWeight="Bold" Margin="0,20" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBlock Text="Вставьте или приложите карту" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center" Margin="20"/>

            <Button Content="Вставить карту" Width="300" Height="60" FontSize="20" Margin="0,30" Click="ButIC_Click"/>
        </StackPanel> 
    </Grid>
</Page>

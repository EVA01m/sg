<Page x:Class="bank.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:bank"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainMenuPage">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Здравствуйте {USER}!" FontSize="22" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <Button Content="Пополнить средства" Height="45" Margin="0,8" FontSize="16" Click="ButDM_Click"/>
            <Button Content="Снять наличные" Height="45" Margin="0,8" FontSize="16" Click="ButWM_Click"/>
            <Button Content="Получить справку о состоянии счета" Height="45" Margin="0,8" FontSize="16" Click="ButBM_Click"/>
            <Button Content="Вернуть карту" Height="45" Margin="0,8" FontSize="16" Click="ButRM_Click"/>
        </StackPanel>
    </Grid>
</Page>

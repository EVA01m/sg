<Window x:Class="Magaz4._1NaumPir.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Magaz4._1NaumPir"
        Title="Драгоценный мир" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:DiscountVisibilityConverter x:Key="DiscountVisibility"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="Black" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UserInfo" FontWeight="Bold" VerticalAlignment="Center" Foreground="Black"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                    <Label Content="Поиск:" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                    <TextBox x:Name="SearchBox" Width="200" Margin="5" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Выйти" Click="Logout_Click" Width="80" BorderBrush="White" Foreground="White">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>
        <ListBox x:Name="ProductsList" Grid.Row="1" Margin="0" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch" Background="#FFCA5923" BorderBrush="Black">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10,10,10,10" Margin="0,0,0,0" MinHeight="120">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="D:\32P NAUMOV AND PIROGOV\Magaz4.1NaumPir\Magaz4.1NaumPir\Resources\netk.jpg" 
                                   Width="80" Height="80" Stretch="Uniform" Grid.Column="0" 
                                   VerticalAlignment="Top" Margin="0,0,0,0"/>
                            <StackPanel Grid.Column="1" Margin="15,0,15,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5" FontSize="14" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Manufacturer, StringFormat=Производитель: {0}}" FontSize="13" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} руб.}" TextDecorations="{Binding PriceDecorations}" Margin="0,0,10,0" FontSize="14"/>
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N0} руб.}" FontWeight="Bold" Foreground="Green" FontSize="16"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Background="Orange" CornerRadius="5" Width="80" Height="80" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                                    Margin="0,0,0,0"
                                    Visibility="{Binding DiscountPercent, Converter={StaticResource DiscountVisibility}}">
                                <TextBlock Text="{Binding DiscountPercent, StringFormat={}{0:F0}%}" 
                                           FontSize="20" FontWeight="Bold" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Background="Gray" CornerRadius="5" Width="80" Height="80" 
        HorizontalAlignment="Center" VerticalAlignment="Top" 
        Margin="0,0,0,0"
        Visibility="{Binding Buy}">
                                <TextBlock Text="{Binding Buy, StringFormat={}{0:F0}%}" 
               FontSize="20" FontWeight="Bold" Foreground="White" 
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
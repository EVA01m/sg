<Window x:Class="Magaz4._1NaumPir.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="470" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FFCA5923">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Драгоценный мир" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="White"/>
        <Label Grid.Row="1" Grid.Column="0" Content="Логин:" Foreground="White" FontWeight="Bold"/>
        <TextBox x:Name="LoginBox" Grid.Row="1" Grid.Column="1" Margin="5"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Пароль:" Foreground="White" FontWeight="Bold"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="5"/>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="LoginBtn" Content="Войти" Click="LoginBtn_Click" Width="116" Margin="5" Height="47" Foreground="White" BorderBrush="White">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="Red" Offset="1"/>
                        <GradientStop Color="#FFEC0000" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button x:Name="GuestBtn" Content="Гость" Click="GuestBtn_Click" Width="99" Margin="5" Height="46" Foreground="White" BorderBrush="White">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="Red" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>
        <TextBlock x:Name="ErrorMsg" Grid.Row="4" Grid.ColumnSpan="2" Foreground="#FF00FFE2" TextAlignment="Center"/>
        <Border x:Name="CaptchaPanel" Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="1" Margin="0,10" Padding="10" Visibility="Collapsed">
            <StackPanel>
                <Canvas x:Name="CaptchaCanvas" Width="250" Height="100" Background="White" Margin="0,5" ClipToBounds="True"/>
                <TextBox x:Name="CaptchaInput" Width="120" Margin="0,5"/>
                <TextBlock x:Name="CaptchaError" Foreground="#FF00FFE2"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="BlockMsg" Grid.Row="6" Grid.ColumnSpan="2" Foreground="#FF00FFE2" TextAlignment="Center"/>
    </Grid>
</Window>